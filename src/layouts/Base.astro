---
import { languages, switchLangPath, getDict, localePath, type Lang } from '../i18n';
import LangSwitcher from '../components/LangSwitcher.astro';
import ThemeScript from '../components/ThemeScript.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Porto from '../components/porto/Porto';
import { portoPool } from '../lib/porto';
import '@fontsource-variable/nunito';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/polish.css';
import '../styles/print.css';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Which nav item is current: 'map' | 'skills' | 'glossary' | 'cheatsheets' */
  active?: string;
  /** Wider page without the prose limit (map, skills). */
  wide?: boolean;
}
const { lang, title, description, active, wide = false } = Astro.props;
const dict = getDict(lang);
const fullTitle = title ? `${title} · ${dict.site.name}` : dict.site.name;
const path = Astro.url.pathname;
const funData = {
  lines: {
    poke: portoPool(lang, 'poke'),
    idle: portoPool(lang, 'idle'),
    fastScroll: portoPool(lang, 'fastScroll'),
    night: portoPool(lang, 'night'),
    console: portoPool(lang, 'console'),
  },
  secrets: dict.fun.secrets,
  t: {
    secretToast: dict.fun.secretToast,
    hush: dict.fun.hush,
    unhush: dict.fun.unhush,
    hushed: dict.fun.hushed,
    unhushed: dict.fun.unhushed,
  },
};
const links = [
  { key: 'map', href: localePath(lang, '/'), label: dict.nav.map },
  { key: 'skills', href: localePath(lang, '/skills'), label: dict.nav.skills },
  { key: 'glossary', href: localePath(lang, '/glossary'), label: dict.nav.glossary },
  { key: 'cheatsheets', href: localePath(lang, '/cheatsheets'), label: dict.nav.cheatsheets },
];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeScript />
    <title>{fullTitle}</title>
    <meta name="description" content={description ?? dict.site.subtitle} />
    <meta name="theme-color" content="#FFF8EE" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161A2B" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={dict.site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description ?? dict.site.subtitle} />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'} />
    {languages.map((l) => <link rel="alternate" hreflang={l} href={switchLangPath(path, l)} />)}
    <link rel="alternate" hreflang="x-default" href="/" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{dict.nav.skip}</a>

    <div class="view-banner" data-view-banner hidden>
      <div class="container view-banner-inner">
        <span data-view-text data-template={dict.view.banner}></span>
        <button type="button" class="btn btn-ghost btn-small" data-view-exit>{dict.view.exit}</button>
      </div>
    </div>

    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={localePath(lang, '/')} aria-label={dict.nav.home}>
          <svg class="brand-mark" viewBox="0 0 40 40" width="36" height="36" aria-hidden="true">
            <circle cx="20" cy="20" r="18" fill="var(--sun)" opacity="0.28" />
            <rect x="13" y="14" width="14" height="17" rx="5" fill="var(--sun)" stroke="var(--ink)" stroke-width="2.2" />
            <path d="M15 14c0-4 2.5-6 5-6s5 2 5 6" fill="none" stroke="var(--ink)" stroke-width="2.2" stroke-linecap="round" />
            <circle cx="20" cy="22.5" r="3" fill="#fff" />
          </svg>
          <span class="brand-name">{dict.site.name}</span>
        </a>

        <nav class="main-nav" aria-label={dict.nav.label}>
          <button
            type="button"
            class="menu-btn"
            aria-expanded="false"
            aria-controls="nav-links"
            data-menu-btn
          >
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
            </svg>
            <span>{dict.nav.menu}</span>
          </button>
          <ul id="nav-links" class="nav-links" data-nav-links>
            {
              links.map((l) => (
                <li>
                  <a href={l.href} aria-current={active === l.key ? 'page' : undefined}>
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="header-tools">
          <a
            class="pill pill-xp"
            href={localePath(lang, '/')}
            data-xp-pill
            data-template={dict.nav.xpPill}
            data-label={dict.nav.xpLabel}
            aria-label={dict.nav.xpLabel.replace('{xp}', '0')}
          >
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
              <path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.1 1.2-6.5-4.8-4.6 6.6-.9z" fill="var(--sun)" stroke="var(--ink)" stroke-width="1.4" stroke-linejoin="round" />
            </svg>
            <span data-xp-text>{dict.nav.xpPill.replace('{xp}', '0')}</span>
          </a>
          <LangSwitcher lang={lang} />
          <ThemeToggle lang={lang} />
        </div>
      </div>
    </header>

    <div class="container notes-area" data-notes>
      <p class="note-line" data-note-storage hidden>{dict.notes.noStorage}</p>
      <p class="note-line" data-note-share hidden>{dict.notes.brokenShare}</p>
    </div>

    <main id="main" tabindex="-1" class:list={['container', 'page', { 'page-wide': wide }]}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p class="footer-line">{dict.footer.line}</p>
        <div class="footer-links">
          <a href={localePath(lang, '/mentor')}>{dict.footer.mentor}</a>
          <button type="button" class="link-btn" data-hush>{dict.fun.hush}</button>
          <button type="button" class="link-btn" data-reset-open>{dict.footer.reset}</button>
        </div>
      </div>
    </footer>

    <dialog class="dialog" data-reset-dialog aria-labelledby="reset-title">
      <form method="dialog" class="dialog-body">
        <h2 id="reset-title" class="dialog-title">{dict.reset.title}</h2>
        <p>{dict.reset.body}</p>
        <div class="dialog-actions">
          <button type="submit" value="cancel" class="btn btn-ghost" autofocus>{dict.reset.cancel}</button>
          <button type="submit" value="confirm" class="btn btn-primary">{dict.reset.confirm}</button>
        </div>
      </form>
    </dialog>

    <div class="buddy" data-buddy>
      <p class="buddy-bubble" data-buddy-bubble role="status" hidden></p>
      <button type="button" class="buddy-btn" data-buddy-btn aria-label={dict.fun.buddyLabel}>
        <Porto mood="hello" size={68} />
      </button>
    </div>
    <script type="application/json" id="fun-data" set:html={JSON.stringify(funData)} />

    <div class="toast-area" role="status" aria-live="polite" data-reset-done={dict.reset.done} data-view-exited={dict.view.exited}></div>

    <script>
      import { xp } from '../lib/progress';
      import {
        exitViewMode,
        getProgress,
        isViewMode,
        resetProgress,
        shareLinkBroken,
        storageAvailable,
        subscribe,
      } from '../lib/store';
      import { toast } from '../lib/toast';
      import { fill } from '../i18n';
      import { initFun, type FunData } from '../lib/fun';

      initFun(JSON.parse(document.getElementById('fun-data')!.textContent!) as FunData);

      const $ = <T extends Element>(sel: string) => document.querySelector<T>(sel);

      // XP pill and view banner follow the progress.
      const pill = $<HTMLAnchorElement>('[data-xp-pill]');
      const pillText = $<HTMLElement>('[data-xp-text]');
      const banner = $<HTMLElement>('[data-view-banner]');
      const bannerText = $<HTMLElement>('[data-view-text]');

      // The XP number counts up and the pill hops when points arrive.
      let shownXp = -1;
      let xpTimer = 0;
      const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
      function showXp(value: number) {
        if (!pill || !pillText) return;
        const points = value.toLocaleString(document.documentElement.lang);
        pillText.textContent = fill(pill.dataset.template!, { xp: points });
      }
      function render() {
        const p = getProgress();
        const total = xp(p);
        if (pill && pillText) {
          pill.setAttribute('aria-label', fill(pill.dataset.label!, { xp: total.toLocaleString(document.documentElement.lang) }));
          cancelAnimationFrame(xpTimer);
          if (shownXp < 0 || calm || total <= shownXp) {
            showXp(total);
          } else {
            const from = shownXp;
            const start = performance.now();
            const step = (now: number) => {
              const k = Math.min(1, (now - start) / 600);
              showXp(Math.round(from + (total - from) * (1 - (1 - k) ** 3)));
              if (k < 1) xpTimer = requestAnimationFrame(step);
            };
            xpTimer = requestAnimationFrame(step);
            pill.classList.remove('is-bump');
            void pill.offsetWidth;
            pill.classList.add('is-bump');
          }
          shownXp = total;
        }
        const view = isViewMode();
        document.documentElement.toggleAttribute('data-view-mode', view);
        if (banner && bannerText) {
          banner.hidden = !view;
          bannerText.textContent = fill(bannerText.dataset.template!, { hero: p.hero || '?' });
        }
      }
      render();
      subscribe(render);

      $('[data-view-exit]')?.addEventListener('click', () => {
        exitViewMode();
        const msg = $<HTMLElement>('.toast-area')?.dataset.viewExited;
        if (msg) toast(msg);
      });

      // Notes: storage blocked, broken share link.
      if (!storageAvailable()) $<HTMLElement>('[data-note-storage]')!.hidden = false;
      if (shareLinkBroken()) $<HTMLElement>('[data-note-share]')!.hidden = false;

      // Phone menu.
      const menuBtn = $<HTMLButtonElement>('[data-menu-btn]');
      const navLinks = $<HTMLElement>('[data-nav-links]');
      menuBtn?.addEventListener('click', () => {
        const open = menuBtn.getAttribute('aria-expanded') !== 'true';
        menuBtn.setAttribute('aria-expanded', String(open));
        navLinks?.classList.toggle('is-open', open);
      });
      document.addEventListener('click', (e) => {
        if (menuBtn?.getAttribute('aria-expanded') !== 'true') return;
        if ((e.target as Element).closest('[data-menu-btn], [data-nav-links]')) return;
        menuBtn.setAttribute('aria-expanded', 'false');
        navLinks?.classList.remove('is-open');
      });
      const onScroll = () => document.documentElement.toggleAttribute('data-scrolled', scrollY > 8);
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && menuBtn?.getAttribute('aria-expanded') === 'true') {
          menuBtn.setAttribute('aria-expanded', 'false');
          navLinks?.classList.remove('is-open');
          menuBtn.focus();
        }
      });

      // A tick made right now gets a small pop; ticks restored from the
      // saved progress do not.
      document.addEventListener('change', (e) => {
        const input = e.target as HTMLInputElement;
        if (!input.matches?.('input[data-tick]') || !input.checked) return;
        for (const el of [input.closest('.tick'), input.closest('.mission, .break')]) {
          if (!el) continue;
          el.classList.add('is-fresh');
          setTimeout(() => el.classList.remove('is-fresh'), 600);
        }
      });

      // Blocks below the fold fade in once, the first time they are reached.
      if (!calm && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const el = entry.target as HTMLElement;
              io.unobserve(el);
              el.dataset.rise = 'in';
              setTimeout(() => el.removeAttribute('data-rise'), 400);
            }
          },
          { rootMargin: '0px 0px -6% 0px' },
        );
        const blocks = document.querySelectorAll<HTMLElement>(
          '.level > section > .card, .level-body > .diagram, .level-body > .widget, .level-body > .card, [data-rise]',
        );
        for (const el of blocks) {
          if (el.getBoundingClientRect().top < innerHeight) {
            el.removeAttribute('data-rise');
            continue;
          }
          el.dataset.rise = 'wait';
          io.observe(el);
        }
      }

      // Copy buttons on every code block.
      document.addEventListener('click', async (e) => {
        const btn = (e.target as Element | null)?.closest<HTMLButtonElement>('.copy-btn');
        if (!btn) return;
        const code = btn.parentElement?.querySelector('pre')?.innerText ?? '';
        try {
          await navigator.clipboard.writeText(code.replace(/\n$/, ''));
        } catch {
          const area = document.createElement('textarea');
          area.value = code;
          area.style.position = 'fixed';
          area.style.opacity = '0';
          document.body.append(area);
          area.select();
          document.execCommand('copy');
          area.remove();
        }
        const original = btn.textContent;
        btn.textContent = btn.dataset.copied ?? original;
        btn.classList.add('is-done');
        setTimeout(() => {
          btn.textContent = original;
          btn.classList.remove('is-done');
        }, 1500);
      });

      // Reset dialog.
      const dialog = $<HTMLDialogElement>('[data-reset-dialog]');
      $('[data-reset-open]')?.addEventListener('click', () => dialog?.showModal());
      dialog?.addEventListener('close', () => {
        if (dialog.returnValue !== 'confirm') return;
        resetProgress();
        const msg = $<HTMLElement>('.toast-area')?.dataset.resetDone;
        if (msg) toast(msg);
      });
    </script>
  </body>
</html>
