---
// The quest map: one SVG for desktop (1000×640) and one for phones
// (360×1100). Rendered with empty progress; a client script sets node
// states, the travelled path and Porto's place.
//
// Everything that moves all the time (clouds, sun glow, birds, Porto, the
// ring around the current node) is plain HTML above or below the SVG. The
// browser moves such layers on the GPU; an animation inside the SVG would
// repaint the whole map on every frame.
import Landmark from './Landmark.astro';
import Porto from '../porto/Porto';
import Icon from '../ui/Icon.astro';
import { iconBody } from '../../lib/icons';
import { fill, getDict, localePath, plural, type Lang } from '../../i18n';
import type { LevelSummary } from '../../lib/levels';

interface Props {
  lang: Lang;
  levels: LevelSummary[];
  bossExists: boolean;
}
const { lang, levels, bossExists } = Astro.props;
const dict = getDict(lang);

type Pt = { x: number; y: number };
type Layout = {
  key: 'desktop' | 'phone';
  w: number;
  h: number;
  points: Pt[]; // 8 levels, then the boss
  label: (p: Pt, i: number) => { x: number; y: number; w: number; h: number; align: 'center' | 'left' | 'right' };
  porto: (p: Pt) => Pt;
  portoSize: number;
  scenery: string;
  sky: Sky[];
};
type Sky =
  | { kind: 'cloud' | 'bird'; top: number; w: number; dur: number; delay: number }
  | { kind: 'sun'; cx: number; cy: number; r: number };

const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;

// Moving parts of the landmarks, in landmark units (see Landmark.astro):
// box = [x, y, width, height], body = the drawing inside that box.
type Fx = { cls: string; box: [number, number, number, number]; body: string };
const INK = 'stroke="var(--map-ink)" stroke-width="2" stroke-linejoin="round"';
const puff = (n: number): Fx => ({
  cls: `fx-puff fx-puff-${n}`,
  box: [20, -73, 12, 12],
  body: `<circle cx="6" cy="6" r="5" fill="var(--card)" ${INK}/>`,
});
const landmarkFx: Record<string, Fx[]> = {
  tent: [{ cls: 'fx-fire', box: [31, -22, 12, 20], body: `<path d="M2 19 q3 -14 3 -16 q6 8 4 16 Z" fill="var(--sun)" ${INK}/>` }],
  workshop: [puff(1), puff(2), puff(3)],
  lighthouse: [{ cls: 'fx-beam', box: [6, -80, 56, 32], body: '<path d="M0 17 L56 0 L56 32 Z" fill="var(--sun)"/>' }],
  rocket: [{ cls: 'fx-flame', box: [-7, -21, 14, 18], body: `<path d="M1 1 Q7 17 13 1 Z" fill="var(--sun)" ${INK}/>` }],
  castle: [{ cls: 'fx-flag', box: [0, -88, 24, 16], body: `<path d="M0 2 L22 8 L0 15 Z" fill="var(--coral)" ${INK}/>` }],
};

const layouts: Layout[] = [
  {
    key: 'desktop',
    w: 1000,
    h: 640,
    points: [
      { x: 90, y: 528 },
      { x: 300, y: 505 },
      { x: 165, y: 335 },
      { x: 380, y: 290 },
      { x: 545, y: 400 },
      { x: 715, y: 470 },
      { x: 840, y: 330 },
      { x: 670, y: 200 },
      { x: 885, y: 118 },
    ],
    label: (p) => ({ x: p.x - 80, y: p.y + 36, w: 160, h: 72, align: 'center' }),
    porto: (p) => ({ x: p.x + 30, y: p.y + 20 }),
    portoSize: 64,
    scenery: 'desktop',
    sky: [
      { kind: 'sun', cx: 610, cy: 84, r: 28 },
      { kind: 'cloud', top: 52, w: 132, dur: 120, delay: -18 },
      { kind: 'cloud', top: 28, w: 168, dur: 170, delay: -95 },
      { kind: 'cloud', top: 150, w: 92, dur: 90, delay: -52 },
      { kind: 'cloud', top: 96, w: 110, dur: 140, delay: -118 },
      { kind: 'bird', top: 118, w: 28, dur: 34, delay: -6 },
      { kind: 'bird', top: 142, w: 20, dur: 34, delay: -7.6 },
      { kind: 'bird', top: 236, w: 22, dur: 46, delay: -30 },
    ],
  },
  {
    key: 'phone',
    w: 360,
    h: 1100,
    points: [
      { x: 92, y: 1030 },
      { x: 268, y: 914 },
      { x: 92, y: 798 },
      { x: 268, y: 682 },
      { x: 92, y: 566 },
      { x: 268, y: 450 },
      { x: 92, y: 334 },
      { x: 268, y: 218 },
      { x: 180, y: 96 },
    ],
    label: (p, i) =>
      i === 8
        ? { x: p.x - 150, y: p.y + 36, w: 300, h: 56, align: 'center' }
        : p.x < 180
          ? { x: p.x + 40, y: p.y - 34, w: 170, h: 76, align: 'left' }
          : { x: p.x - 210, y: p.y - 34, w: 170, h: 76, align: 'right' },
    porto: (p) => ({ x: p.x + (p.x < 180 ? -74 : 20), y: p.y + 8 }),
    portoSize: 54,
    scenery: 'phone',
    sky: [
      { kind: 'sun', cx: 290, cy: 60, r: 20 },
      { kind: 'cloud', top: 36, w: 84, dur: 80, delay: -12 },
      { kind: 'cloud', top: 132, w: 96, dur: 110, delay: -64 },
      { kind: 'cloud', top: 586, w: 70, dur: 95, delay: -40 },
      { kind: 'bird', top: 250, w: 18, dur: 26, delay: -9 },
    ],
  },
];

// Smooth path through the points (Catmull-Rom → cubic Bézier), one
// segment per hop so travelled hops can be coloured separately.
function segments(pts: Pt[]): string[] {
  const out: string[] = [];
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[i - 1] ?? pts[i]!;
    const p1 = pts[i]!;
    const p2 = pts[i + 1]!;
    const p3 = pts[i + 2] ?? p2;
    const c1 = { x: p1.x + (p2.x - p0.x) / 6, y: p1.y + (p2.y - p0.y) / 6 };
    const c2 = { x: p2.x - (p3.x - p1.x) / 6, y: p2.y - (p3.y - p1.y) / 6 };
    out.push(
      `M${p1.x} ${p1.y} C${c1.x.toFixed(1)} ${c1.y.toFixed(1)} ${c2.x.toFixed(1)} ${c2.y.toFixed(1)} ${p2.x} ${p2.y}`,
    );
  }
  return out;
}

const landmarkOf = (i: number) => (i === 8 ? 'castle' : levels[i]!.landmark);
const titleOf = (i: number) => (i === 8 ? dict.map.bossTitle : levels[i]!.title);
const hrefOf = (i: number) =>
  i === 8 ? (bossExists ? localePath(lang, '/boss') : null) : levels[i]!.exists ? localePath(lang, `/level/${i + 1}`) : null;
const weeksOf = (i: number) => (i === 8 ? 1 : levels[i]!.weeks);
// Where the hover preview sits, so it never leaves the map.
const tipSide = (p: Pt, w: number) => (p.y < 190 ? 'side' : p.x < 170 ? 'right' : p.x > w - 170 ? 'left' : 'top');
const ariaOf = (i: number, state: string) =>
  i === 8
    ? fill(dict.map.bossLabel, { title: titleOf(i), state })
    : fill(dict.map.nodeLabel, { n: i + 1, title: titleOf(i), state });
---
<div
  class="quest-map"
  data-quest-map
  data-state-done={dict.map.stateDone}
  data-state-current={dict.map.stateCurrent}
  data-state-ahead={dict.map.stateAhead}
  data-peek={dict.map.peek}
>
  {
    layouts.map((L) => {
      const segs = segments(L.points);
      return (
        <div
          class={`map-stage map-${L.key}`}
          data-stage
          data-w={L.w}
          data-h={L.h}
          data-nodes={JSON.stringify(L.points.map((p) => [pct(p.x, L.w), pct(p.y, L.h)]))}
          data-porto={JSON.stringify(L.points.map((p) => { const at = L.porto(p); return [(at.x / L.w) * 100, ((at.y - L.portoSize) / L.h) * 100]; }))}
        >
        <div class="map-sky" aria-hidden="true">
          {[...L.sky].sort((a, b) => Number(a.kind === 'sun') - Number(b.kind === 'sun')).map((item) => {
            if (item.kind === 'sun') {
              const d = item.r * 3.6;
              const place = `left:${pct(item.cx - d / 2, L.w)};top:${pct(item.cy - d / 2, L.h)};width:${pct(d, L.w)}`;
              return (
                <>
                  <svg class="sky-item sky-rays" viewBox="-50 -50 100 100" style={place}>
                    {Array.from({ length: 12 }, (_, k) => (
                      <path d="M0 -36 V-45" transform={`rotate(${k * 30})`} />
                    ))}
                  </svg>
                  <svg class="sky-item sky-sun" viewBox="-50 -50 100 100" style={place}>
                    <circle r="27.5" class="sun-disc" />
                    {/* sunglasses and a smirk */}
                    <path class="sun-ink" d="M-21 -9 H21 M-19 -9 v5 a7.5 7.5 0 0 0 15 0 v-5 Z M4 -9 v5 a7.5 7.5 0 0 0 15 0 v-5 Z" />
                    <path class="sun-smile" d="M-7 12 Q2 18 10 9" />
                  </svg>
                </>
              );
            }
            const style = `top:${pct(item.top, L.h)};width:${pct(item.w, L.w)};--dur:${item.dur}s;--delay:${item.delay}s`;
            return item.kind === 'cloud' ? (
              <svg class="sky-item sky-cloud" viewBox="0 0 120 48" style={style}>
                <path d="M18 44 Q2 44 4 32 Q5 22 18 22 Q22 6 42 8 Q54 2 66 14 Q84 8 90 24 Q112 22 114 36 Q114 44 100 44 Z" />
              </svg>
            ) : (
              <span class="sky-item sky-bird" style={style}>
                <svg viewBox="0 0 24 12">
                  <path d="M1 9 Q7 0 12 8 Q17 0 23 9" />
                </svg>
              </span>
            );
          })}
        </div>
        <svg
          class="map-svg"
          viewBox={`0 0 ${L.w} ${L.h}`}
          role="group"
          aria-labelledby={`map-title-${L.key}`}
          aria-describedby={`map-desc-${L.key}`}
        >
          <title id={`map-title-${L.key}`}>{dict.home.mapTitle}</title>
          <desc id={`map-desc-${L.key}`}>{dict.home.mapDesc}</desc>

          {/* scenery */}
          <g aria-hidden="true" class="scenery">
            {L.key === 'desktop' ? (
              <>
                <path d="M0 640 V520 Q160 440 330 520 T660 500 T1000 470 V640 Z" fill="var(--map-hill)" />
                <path d="M0 640 V600 Q220 540 460 600 T1000 580 V640 Z" fill="var(--map-hill-2)" />
                <path d="M420 300 Q560 220 720 290 T1000 250 V330 Q840 300 720 340 T420 330 Z" fill="var(--map-hill)" opacity="0.6" />
                {[[40, 450], [150, 300], [450, 560], [610, 330], [960, 400], [560, 190], [300, 400]].map(([tx, ty]) => (
                  <g transform={`translate(${tx} ${ty})`}>
                    <rect x="-2" y="-6" width="4" height="10" fill="var(--map-trunk)" />
                    <path d="M-11 -4 L0 -28 L11 -4 Z" fill="var(--map-tree)" />
                  </g>
                ))}
              </>
            ) : (
              <>
                <path d="M0 1100 V1040 Q100 990 200 1030 T360 1010 V1100 Z" fill="var(--map-hill)" />
                <path d="M0 760 Q120 720 200 760 T360 740 V820 Q240 800 160 830 T0 820 Z" fill="var(--map-hill)" opacity="0.6" />
                <path d="M0 420 Q140 380 220 420 T360 400 V470 Q240 450 160 480 T0 470 Z" fill="var(--map-hill)" opacity="0.6" />
                {[[30, 960], [330, 840], [26, 720], [334, 610], [30, 490], [332, 380], [26, 260]].map(([tx, ty]) => (
                  <g transform={`translate(${tx} ${ty})`}>
                    <rect x="-2" y="-6" width="4" height="10" fill="var(--map-trunk)" />
                    <path d="M-10 -4 L0 -24 L10 -4 Z" fill="var(--map-tree)" />
                  </g>
                ))}
              </>
            )}
          </g>

          {/* path: dashed ahead, solid teal where travelled */}
          <g aria-hidden="true" class="map-path">
            {segs.map((d) => (
              <path d={d} class="path-ahead" />
            ))}
            {segs.map((d, i) => (
              <path d={d} class="path-done" data-seg={i + 1} pathLength="1" />
            ))}
          </g>

          {/* landmarks */}
          {L.points.map((p, i) => (
            <Landmark name={landmarkOf(i)} x={p.x} y={p.y - (i === 8 ? 28 : 20)} scale={L.key === 'phone' ? 0.82 : 1} />
          ))}

          {/* nodes */}
          {L.points.map((p, i) => {
            const n = i + 1;
            const lab = L.label(p, i);
            const href = hrefOf(i);
            const inner = (
              <>
                <g class="node-dot" style={`--i:${i}`}>
                  <circle class="node-pulse" cx={p.x} cy={p.y} r="38" />
                  <circle class="node-focus" cx={p.x} cy={p.y} r="40" />
                  <circle class="node-bg" cx={p.x} cy={p.y} r="32" />
                  <text class="node-num" x={p.x} y={p.y} dy="0.36em" text-anchor="middle">
                    {i === 8 ? '★' : n}
                  </text>
                  <path class="node-check" d={`M${p.x - 12} ${p.y + 1} l8 8 l16 -18`} />
                </g>
                <g class="icon node-badge" transform={`translate(${p.x + 14} ${p.y - 40}) scale(1.05)`}>
                  <circle class="node-badge-bg" cx="12" cy="12" r="15" />
                  <Fragment set:html={iconBody(i === 8 ? '🏰' : levels[i]!.badge.emoji) ?? ''} />
                </g>
                <foreignObject x={lab.x} y={lab.y} width={lab.w} height={lab.h}>
                  <div class={`node-label align-${lab.align}`}>
                    <span class="node-title">
                      {i === 8 ? dict.map.boss : fill(dict.map.level, { n })} · {titleOf(i)}
                    </span>
                    <span class="node-meta">
                      <span class="pill node-weeks">{plural(lang, weeksOf(i), dict.plural.week)}</span>
                      <span class="node-state" data-node-state>
                        {href ? (i === 0 ? dict.map.stateCurrent : dict.map.peek) : dict.map.soon}
                      </span>
                    </span>
                  </div>
                </foreignObject>
              </>
            );
            return href ? (
              <a
                href={href}
                class={`map-node ${i === 0 ? 'is-current' : 'is-ahead'}`}
                data-node={n}
                aria-label={ariaOf(i, i === 0 ? dict.map.stateCurrent : dict.map.stateAhead)}
                data-aria-done={ariaOf(i, dict.map.stateDone)}
                data-aria-current={ariaOf(i, dict.map.stateCurrent)}
                data-aria-ahead={ariaOf(i, dict.map.stateAhead)}
              >
                {inner}
              </a>
            ) : (
              <g class={`map-node is-soon ${i === 0 ? 'is-current' : 'is-ahead'}`} data-node={n}>
                {inner}
              </g>
            );
          })}

        </svg>
        <div class="map-fx" aria-hidden="true">
          {L.points.flatMap((p, i) => {
            const sc = L.key === 'phone' ? 0.82 : 1;
            const oy = p.y - (i === 8 ? 28 : 20);
            return (landmarkFx[landmarkOf(i)] ?? []).map((f) => (
              <svg
                class={`fx-item ${f.cls}`}
                viewBox={`0 0 ${f.box[2]} ${f.box[3]}`}
                style={`left:${pct(p.x + f.box[0] * sc, L.w)};top:${pct(oy + f.box[1] * sc, L.h)};width:${pct(f.box[2] * sc, L.w)}`}
                set:html={f.body}
              />
            ));
          })}
          <span class="map-ping" data-ping style={`width:${pct(64, L.w)}`} />
          <span
            class="map-porto"
            data-map-porto
            style={`width:${pct(L.portoSize, L.w)};left:${pct(L.porto(L.points[0]!).x, L.w)};top:${pct(L.porto(L.points[0]!).y - L.portoSize, L.h)}`}
          >
            <span class="map-porto-flip" data-porto-flip>
              <span class="map-porto-hop" data-porto-hop>
                <Porto mood="hello" size={L.portoSize} />
              </span>
            </span>
          </span>
          {L.key === 'desktop' &&
            levels.map((lv, i) => {
              const p = L.points[i]!;
              if (!lv.exists) return null;
              return (
                <div class={`map-tip tip-${tipSide(p, L.w)}`} data-tip={i + 1} style={`left:${pct(p.x, L.w)};top:${pct(p.y, L.h)}`}>
                  <p class="map-tip-badge">
                    <Icon name={lv.badge.emoji} size={20} /> {dict.level.badgePreview}: {lv.badge.name}
                  </p>
                  <ol>
                    {lv.missions.slice(0, 4).map((m) => <li>{m.title}</li>)}
                  </ol>
                  {lv.missions.length > 4 && <p class="map-tip-more">+ {plural(lang, lv.missions.length - 4, dict.plural.mission)}</p>}
                </div>
              );
            })}
        </div>
        </div>
      );
    })
  }
</div>
<script is:inline>
  // Until the saved progress is read, Porto and the ring stay hidden, so
  // they never flash at the wrong node.
  document.querySelector('[data-quest-map]').classList.add('is-loading');
  // First map of the session: the nodes pop in one after another.
  try {
    if (!sessionStorage.getItem('aiquest:mapSeen') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      sessionStorage.setItem('aiquest:mapSeen', '1');
      document.querySelector('[data-quest-map]').classList.add('is-intro');
    }
  } catch (e) {}
</script>

<script>
  import { BOSS, currentLevel, levelState, type NodeState } from '../../lib/progress';
  import { getProgress, subscribe } from '../../lib/store';

  const root = document.querySelector<HTMLElement>('[data-quest-map]');

  function render() {
    if (!root) return;
    const p = getProgress();
    const states: Record<number, NodeState> = {};
    for (let n = 1; n <= 8; n++) states[n] = levelState(p, n);
    states[9] = p.boss.doneAt ? 'done' : currentLevel(p) === BOSS ? 'current' : 'ahead';
    const stateText = { done: root.dataset.stateDone!, current: root.dataset.stateCurrent!, ahead: root.dataset.peek! };

    root.querySelectorAll<SVGElement>('[data-node]').forEach((node) => {
      const s = states[Number(node.dataset.node)]!;
      node.classList.toggle('is-done', s === 'done');
      node.classList.toggle('is-current', s === 'current');
      node.classList.toggle('is-ahead', s === 'ahead');
      if (node.classList.contains('is-soon')) return;
      const label = node.querySelector('[data-node-state]');
      if (label) label.textContent = stateText[s];
      const aria = node.dataset[`aria${s[0]!.toUpperCase()}${s.slice(1)}`];
      if (aria) node.setAttribute('aria-label', aria);
    });

    root.querySelectorAll<SVGPathElement>('[data-seg]').forEach((seg) => {
      seg.classList.toggle('is-travelled', states[Number(seg.dataset.seg)] === 'done');
    });
    root.classList.add('is-ready');

    const current = Number(Object.entries(states).find(([, s]) => s === 'current')?.[0] ?? 0);
    placePorto(current);
  }

  // Porto stands by the current node (by the boss when all is done) and
  // hops there along the road from where the map last showed him.
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let shown = 0;
  try {
    shown = Number(sessionStorage.getItem('aiquest:mapAt')) || 0;
  } catch {
    /* no walk, that is all */
  }
  let running: Animation[] = [];
  function placePorto(current: number) {
    const at = current || 9;
    running.forEach((a) => a.cancel());
    running = [];
    root!.querySelectorAll<HTMLElement>('[data-stage]').forEach((stage) => {
      const spots = JSON.parse(stage.dataset.porto!) as [number, number][];
      const nodes = JSON.parse(stage.dataset.nodes!) as [string, string][];
      const porto = stage.querySelector<HTMLElement>('[data-map-porto]')!;
      const ping = stage.querySelector<HTMLElement>('[data-ping]')!;
      const [left, top] = spots[at - 1]!;
      porto.style.left = `${left}%`;
      porto.style.top = `${top}%`;
      ping.hidden = !current;
      if (current) [ping.style.left, ping.style.top] = nodes[current - 1]!;
      if (calm || !shown || shown === at || !stage.clientWidth) return;
      hopAlongRoad(stage, porto, shown, at, spots, nodes);
    });
    shown = at;
    try {
      sessionStorage.setItem('aiquest:mapAt', String(at));
    } catch {
      /* fine */
    }
  }

  // Porto hops along the drawn road from node `from` to node `to`.
  function hopAlongRoad(
    stage: HTMLElement,
    porto: HTMLElement,
    from: number,
    to: number,
    spots: [number, number][],
    nodePct: [string, string][],
  ) {
    const W = Number(stage.dataset.w);
    const H = Number(stage.dataset.h);
    const road = [...stage.querySelectorAll<SVGPathElement>('.path-ahead')];
    const nodes = nodePct.map(([x, y]) => [parseFloat(x), parseFloat(y)] as const);
    // Where Porto stands, measured from the node he stands by (in % of the stage).
    const off = (n: number) => [spots[n - 1]![0] - nodes[n - 1]![0], spots[n - 1]![1] - nodes[n - 1]![1]] as const;
    const dir = to > from ? 1 : -1;
    const pts: [number, number][] = [];
    let length = 0;
    for (let n = from; n !== to; n += dir) {
      const seg = road[(dir > 0 ? n : n - 1) - 1];
      if (!seg) return;
      const len = seg.getTotalLength();
      length += len;
      const a = off(n);
      const b = off(n + dir);
      const steps = 10;
      for (let k = pts.length ? 1 : 0; k <= steps; k++) {
        const t = k / steps;
        const at = seg.getPointAtLength(len * (dir > 0 ? t : 1 - t));
        pts.push([(at.x / W) * 100 + a[0] + (b[0] - a[0]) * t, (at.y / H) * 100 + a[1] + (b[1] - a[1]) * t]);
      }
    }
    const [endX, endY] = pts[pts.length - 1]!;
    const px = ([x, y]: [number, number]) =>
      `${(((x - endX) / 100) * stage.clientWidth).toFixed(1)}px ${(((y - endY) / 100) * stage.clientHeight).toFixed(1)}px`;
    const duration = Math.min(3200, Math.max(800, length * 4.4));
    const hops = Math.max(2, Math.round(duration / 280));
    const delay = 200;

    // He faces the way he goes.
    let face = 1;
    const faces = pts.map((p, i) => {
      const dx = (pts[i + 1] ?? p)[0] - p[0];
      if (Math.abs(dx) > 0.15) face = dx < 0 ? -1 : 1;
      return { transform: `scaleX(${face})`, easing: 'steps(1, end)' };
    });
    faces.push({ transform: 'scaleX(1)', easing: 'linear' });

    const flip = porto.querySelector<HTMLElement>('[data-porto-flip]')!;
    const hop = porto.querySelector<HTMLElement>('[data-porto-hop]')!;
    const walk = porto.animate(pts.map((p) => ({ translate: px(p) })), { duration, delay, easing: 'linear', fill: 'backwards' });
    running.push(
      walk,
      flip.animate(faces, { duration, delay, fill: 'backwards' }),
      hop.animate(
        [
          { transform: 'translateY(0) scale(1.12, 0.86)', easing: 'cubic-bezier(0.2, 0.6, 0.4, 1)' },
          { transform: 'translateY(-36%) scale(0.94, 1.08)', easing: 'cubic-bezier(0.6, 0, 0.8, 0.4)' },
          { transform: 'translateY(0) scale(1.12, 0.86)' },
        ],
        { duration: duration / hops, iterations: hops, delay },
      ),
    );
    // One big happy jump on arrival.
    walk.finished
      .then(() => {
        running.push(
          hop.animate(
            [
              { transform: 'translateY(0) scale(1.15, 0.82)', easing: 'cubic-bezier(0.2, 0.6, 0.4, 1)' },
              { transform: 'translateY(-70%) scale(0.92, 1.1) rotate(-8deg)', easing: 'cubic-bezier(0.6, 0, 0.8, 0.4)' },
              { transform: 'translateY(0) scale(1.15, 0.82)', easing: 'cubic-bezier(0.2, 0, 0, 1)' },
              { transform: 'none' },
            ],
            { duration: 620 },
          ),
        );
      })
      .catch(() => {});
  }

  // Hover preview (desktop map only).
  if (root && matchMedia('(hover: hover)').matches) {
    const show = (n: string | undefined, on: boolean) =>
      n && root.querySelector(`[data-tip="${n}"]`)?.classList.toggle('is-on', on);
    root.querySelectorAll<SVGElement>('a[data-node]').forEach((node) => {
      node.addEventListener('pointerenter', () => show(node.dataset.node, true));
      node.addEventListener('pointerleave', () => show(node.dataset.node, false));
      node.addEventListener('focus', () => show(node.dataset.node, true));
      node.addEventListener('blur', () => show(node.dataset.node, false));
    });
  }

  // The sky stops moving while the map is off screen.
  if (root && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => root.classList.toggle('is-away', !e!.isIntersecting)).observe(root);
  }

  render();
  subscribe(render);
</script>
