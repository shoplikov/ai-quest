---
// Shelf of secret achievements: "???" until found.
import Card from '../ui/Card.astro';
import { getDict, type Lang } from '../../i18n';
import { SECRET_IDS } from '../../lib/progress';

interface Props {
  lang: Lang;
}
const F = getDict(Astro.props.lang).fun;
---
<Card class="stat-card secrets-card">
  <p class="stat-label">{F.secretsTitle} <span class="secrets-count" data-secrets-count>0/{SECRET_IDS.length}</span></p>
  <ul class="badge-row secrets-row">
    {
      SECRET_IDS.map((id) => (
        <li class="badge-sticker secret" data-secret={id} data-name={F.secrets[id].name} data-how={F.secrets[id].how}>
          <span class="secret-mark" aria-hidden="true">?</span>
          <span data-secret-name>{F.secretLocked}</span>
        </li>
      ))
    }
  </ul>
  <p class="secrets-hint">{F.secretsHint}</p>
</Card>

<script>
  import { getProgress, subscribe } from '../../lib/store';

  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-secret]'));
  const counter = document.querySelector<HTMLElement>('[data-secrets-count]');
  function render() {
    const found = getProgress().secrets ?? [];
    for (const li of items) {
      const on = found.includes(li.dataset.secret as never);
      li.classList.toggle('is-found', on);
      li.querySelector<HTMLElement>('[data-secret-name]')!.textContent = on ? li.dataset.name! : '???';
      li.querySelector<HTMLElement>('.secret-mark')!.textContent = on ? '★' : '?';
      if (on) li.title = li.dataset.how!;
      else li.removeAttribute('title');
    }
    if (counter) counter.textContent = `${found.length}/${items.length}`;
  }
  render();
  subscribe(render);
</script>
