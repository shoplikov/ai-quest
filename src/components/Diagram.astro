---
// Picks a diagram by name. Labels come from the dictionary of the page's
// language, so the drawings are shared and the text is not.
import { getDict, isLang } from '../i18n';
import BuildingWithDoors from './diagrams/BuildingWithDoors.astro';
import LocalhostVsAll from './diagrams/LocalhostVsAll.astro';
import ReverseProxy from './diagrams/ReverseProxy.astro';
import SshTunnel from './diagrams/SshTunnel.astro';
import FileTree from './diagrams/FileTree.astro';
import Pipe from './diagrams/Pipe.astro';
import Permissions from './diagrams/Permissions.astro';
import RequestResponse from './diagrams/RequestResponse.astro';
import EventLoop from './diagrams/EventLoop.astro';
import ProjectLayout from './diagrams/ProjectLayout.astro';
import ImageVsContainer from './diagrams/ImageVsContainer.astro';
import Volume from './diagrams/Volume.astro';
import ComposeNetwork from './diagrams/ComposeNetwork.astro';
import Join from './diagrams/Join.astro';
import MigrationsTimeline from './diagrams/MigrationsTimeline.astro';
import MeaningMap from './diagrams/MeaningMap.astro';
import CacheAside from './diagrams/CacheAside.astro';

interface Props {
  name: string;
}
const { name } = Astro.props;
const lang = isLang(Astro.params.lang) ? Astro.params.lang : isLang(Astro.currentLocale) ? Astro.currentLocale : 'en';
const t = getDict(lang).diagrams;
const known = ['building-with-doors', 'localhost-vs-all', 'reverse-proxy', 'ssh-tunnel', 'file-tree', 'pipe', 'permissions', 'request-response', 'event-loop', 'project-layout', 'image-vs-container', 'volume', 'compose-network', 'join', 'migrations-timeline', 'meaning-map', 'cache-aside'];
if (!known.includes(name)) throw new Error(`Unknown diagram: ${name}`);
---
{name === 'building-with-doors' && <BuildingWithDoors t={t.buildingWithDoors} />}
{name === 'localhost-vs-all' && <LocalhostVsAll t={t.localhostVsAll} />}
{name === 'reverse-proxy' && <ReverseProxy t={t.reverseProxy} />}
{name === 'ssh-tunnel' && <SshTunnel t={t.sshTunnel} />}
{name === 'file-tree' && <FileTree t={t.fileTree} />}
{name === 'pipe' && <Pipe t={t.pipe} />}
{name === 'permissions' && <Permissions t={t.permissions} />}
{name === 'request-response' && <RequestResponse t={t.requestResponse} />}
{name === 'event-loop' && <EventLoop t={t.eventLoop} />}
{name === 'project-layout' && <ProjectLayout t={t.projectLayout} />}
{name === 'image-vs-container' && <ImageVsContainer t={t.imageVsContainer} />}
{name === 'volume' && <Volume t={t.volume} />}
{name === 'compose-network' && <ComposeNetwork t={t.composeNetwork} />}
{name === 'join' && <Join t={t.join} />}
{name === 'migrations-timeline' && <MigrationsTimeline t={t.migrationsTimeline} />}
{name === 'meaning-map' && <MeaningMap t={t.meaningMap} />}
{name === 'cache-aside' && <CacheAside t={t.cacheAside} />}
