---
import Frame from './Frame.astro';
import Box from './Box.astro';
import Arrow from './Arrow.astro';
import Label from './Label.astro';
import type { Dict } from '../../i18n';
interface Props {
  t: Dict['diagrams']['ragTwoPipelines'];
}
const { t } = Astro.props;
const COLS = [20, 158, 296, 434];
const W = 118;
const ingest = [t.parse, t.clean, t.chunk, t.embed];
const back = [t.rerank, t.prompt, t.generate, t.cite];
---
<Frame id="dg-rag2" w={720} h={340} title={t.title} desc={t.desc}>
  <Label x={20} y={22} text={t.ingestTitle} anchor="start" size={13} weight={800} color="var(--teal-ink)" />
  {ingest.map((text, i) => (
    <g>
      <Box x={COLS[i]!} y={40} w={W} h={50} fill="var(--teal-soft)" seed={300 + i} />
      <Label x={COLS[i]! + W / 2} y={65} text={text} size={13} weight={700} />
    </g>
  ))}
  {[0, 1, 2].map((i) => <Arrow x1={COLS[i]! + W + 2} y1={65} x2={COLS[i + 1]! - 3} y2={65} color="var(--teal-ink)" />)}
  <Arrow x1={COLS[3]! + W + 2} y1={65} x2={596} y2={100} color="var(--teal-ink)" />
  <Label x={578} y={64} text={t.store} size={11} weight={800} color="var(--teal-ink)" />

  <Box x={600} y={60} w={104} h={190} fill="var(--sun-soft)" seed={310} />
  <Label x={652} y={155} text={t.db} size={13} weight={800} />

  <Label x={20} y={138} text={t.queryTitle} anchor="start" size={13} weight={800} color="var(--lilac-ink)" />
  <Box x={20} y={156} w={W + 20} h={50} fill="var(--card-2)" seed={320} />
  <Label x={89} y={181} text={t.embedQ} size={12} weight={700} />
  <Box x={COLS[3]!} y={156} w={W} h={50} fill="var(--card-2)" seed={321} />
  <Label x={COLS[3]! + W / 2} y={181} text={t.retrieve} size={13} weight={700} />
  <Arrow x1={162} y1={181} x2={COLS[3]! - 3} y2={181} color="var(--lilac-ink)" />
  <Arrow x1={598} y1={196} x2={COLS[3]! + W + 3} y2={186} color="var(--lilac-ink)" dashed />

  {back.map((text, i) => {
    const x = COLS[3 - i]!;
    return (
      <g>
        <Box x={x} y={262} w={W} h={50} fill="var(--card-2)" seed={330 + i} />
        <Label x={x + W / 2} y={287} text={text} size={12} weight={700} />
      </g>
    );
  })}
  <Arrow x1={COLS[3]! + W / 2} y1={208} x2={COLS[3]! + W / 2} y2={258} color="var(--lilac-ink)" />
  {[3, 2, 1].map((c) => <Arrow x1={COLS[c]! - 2} y1={287} x2={COLS[c - 1]! + W + 3} y2={287} color="var(--lilac-ink)" />)}
</Frame>
