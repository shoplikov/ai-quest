---
// Index of the printable cheat sheets, one per level.
import Base from '../../../layouts/Base.astro';
import { fill, languages, localePath, type Lang } from '../../../i18n';
import { getLevelEntries } from '../../../lib/levels';
import { getPages } from '../../../lib/pages';
import '../../../styles/pages.css';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const C = getPages(lang).cheatsheets;
const levels = await getLevelEntries(lang);
---
<Base lang={lang} title={C.title} description={C.intro} active="cheatsheets">
  <header class="page-head">
    <h1>{C.title}</h1>
    <p class="page-intro">{C.intro}</p>
  </header>
  <ul class="sheet-grid">
    {levels.map((e) => (
      <li>
        <a class="card sheet-card" href={localePath(lang, `/cheatsheets/${e.data.id}`)}>
          <span class="sheet-emoji" aria-hidden="true">{e.data.badge.emoji}</span>
          <span class="sheet-text">
            <span class="sheet-kicker">{fill(C.level, { n: e.data.id })}</span>
            <span class="sheet-title">{e.data.title}</span>
            <span class="sheet-open">{C.open} →</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</Base>
