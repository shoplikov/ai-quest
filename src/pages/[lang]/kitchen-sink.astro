---
// TEMPORARY: shows every base component. Delete in task 6.4.
import Base from '../../layouts/Base.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import Pill from '../../components/ui/Pill.astro';
import TickRow from '../../components/ui/TickRow.astro';
import ProgressRing from '../../components/ui/ProgressRing.astro';
import Reveal from '../../components/ui/Reveal.astro';
import Dialog from '../../components/ui/Dialog.astro';
import SpeechBubble from '../../components/ui/SpeechBubble.astro';
import { languages, type Lang } from '../../i18n';
import { renderMarkdown } from '../../lib/md';
import Porto from '../../components/porto/Porto';
import { portoLine } from '../../lib/porto';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const code = await renderMarkdown(
  lang,
  'Run this, then look at the output:\n\n```bash\nss -tlnp | grep :8000\n```\n\nThen `curl -v http://localhost:8000`.',
);
---
<Base lang={lang} title="Kitchen sink">
  <h1>Kitchen sink</h1>
  <p class="prose">Temporary page that shows every base component. Not translated on purpose: it is deleted before release.</p>

  <h2>Buttons and pills</h2>
  <p style="display:flex;gap:12px;flex-wrap:wrap">
    <Button>Primary</Button>
    <Button variant="success">Success</Button>
    <Button variant="ghost">Ghost</Button>
    <Button disabled>Disabled</Button>
    <Button href="#cards" small>Link button</Button>
  </p>
  <p style="display:flex;gap:8px;flex-wrap:wrap">
    <Pill>1 week</Pill><Pill tone="xp">120 XP</Pill><Pill tone="teal">Done</Pill><Pill tone="coral">Current</Pill><Pill tone="lilac">Level 2</Pill>
  </p>

  <h2 id="cards">Cards</h2>
  <Card><h3 style="margin-top:0">Card</h3><p>The base surface.</p></Card>
  <Card variant="soft"><strong>Soft:</strong> used for the "It's normal" box.</Card>
  <Card variant="note"><strong>Note:</strong> used for kind notes.</Card>
  <Card variant="warn"><strong>Warn:</strong> used for gentle warnings.</Card>

  <h2>Tick rows</h2>
  <Card>
    <TickRow id="ks-1">Start a tiny web server and see it in <code>ss -tlnp</code></TickRow>
    <TickRow id="ks-2" checked>Already ticked</TickRow>
    <TickRow id="ks-3" disabled>Disabled (level ahead)</TickRow>
  </Card>

  <h2>Progress ring</h2>
  <p style="display:flex;gap:24px">
    <ProgressRing value={0} label="Empty" />
    <ProgressRing value={0.4} label="Some" />
    <ProgressRing value={1} label="Full" />
  </p>

  <h2>Speech bubble</h2>
  <SpeechBubble>
    <Porto slot="mascot" mood="hello" size={84} />
    {portoLine(lang, 'midLevel', 0)}
  </SpeechBubble>

  <h2>Reveal</h2>
  <Reveal summary="Show me why">
    <p>One door, one listener. The first app holds port 8000.</p>
  </Reveal>

  <h2>Code block</h2>
  <Fragment set:html={code} />

  <h2>Dialog and toast</h2>
  <p style="display:flex;gap:12px;flex-wrap:wrap">
    <Button variant="ghost" id="ks-open">Open dialog</Button>
    <Button variant="ghost" id="ks-toast">Show toast</Button>
  </p>
  <Dialog id="ks-dialog" title="A dialog">
    <p>Native dialog. Escape closes it.</p>
    <Fragment slot="actions"><button class="btn btn-primary" value="ok">OK</button></Fragment>
  </Dialog>

  <h2>Table</h2>
  <table>
    <thead><tr><th>Error</th><th>Meaning</th></tr></thead>
    <tbody><tr><td>Connection refused</td><td>Nobody behind the door.</td></tr></tbody>
  </table>

  <h2 id="porto">Porto</h2>
  <div style="display:flex;gap:24px;flex-wrap:wrap;align-items:flex-end">
    {(['hello', 'thinking', 'cheer', 'cozy'] as const).map((mood) => (
      <figure style="margin:0;text-align:center">
        <Porto mood={mood} size={150} label={`Porto, ${mood}`} />
        <figcaption>{mood}</figcaption>
      </figure>
    ))}
  </div>

  <script>
    import { toast } from '../../lib/toast';
    document.getElementById('ks-open')?.addEventListener('click', () =>
      (document.getElementById('ks-dialog') as HTMLDialogElement).showModal(),
    );
    document.getElementById('ks-toast')?.addEventListener('click', () => toast('+20 XP'));
  </script>
</Base>
