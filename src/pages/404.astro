---
// One not-found page for both languages. The server cannot know the
// language of a missing path, so both texts are in the page and a small
// script keeps the one that fits the address (or the saved choice).
import ThemeScript from '../components/ThemeScript.astro';
import Porto from '../components/porto/Porto';
import { pages as en } from '../data/pages.en';
import { pages as ru } from '../data/pages.ru';
import { en as dictEn } from '../i18n/en';
import { ru as dictRu } from '../i18n/ru';
import { BASE, localePath, withBase } from '../i18n';
import '@fontsource-variable/nunito';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/pages.css';
import '../styles/polish.css';

const blocks = [
  { lang: 'en', t: en.notFound, f: dictEn.fun },
  { lang: 'ru', t: ru.notFound, f: dictRu.fun },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <ThemeScript />
    <title>{`${en.notFound.title} · ${dictEn.site.name}`}</title>
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <main class="container not-found crash">
      {blocks.map((b) => (
        <section lang={b.lang} data-lang-block={b.lang} class="crash-screen">
          <p class="crash-face" aria-hidden="true">:(</p>
          <h1>{b.t.title}</h1>
          <p class="crash-code">{b.f.crashCode}</p>
          <ul class="crash-lines">
            {b.f.crashLines.map((line, i) => <li style={`--i:${i}`}>{line}</li>)}
          </ul>
          <p class="not-found-line">{b.t.line}</p>
          <p><a class="btn btn-primary" href={localePath(b.lang)}>{b.f.crashReboot}</a></p>
        </section>
      ))}
      <div class="crash-porto"><Porto mood="cozy" size={120} /></div>
    </main>
    <script>
      import { addSecret } from '../lib/progress';
      import { hasStarted, isViewMode, updateProgress } from '../lib/store';
      if (hasStarted() && !isViewMode()) updateProgress((p) => addSecret(p, 'lost-tourist'));
    </script>
    <script is:inline define:vars={{ base: BASE }}>
      (function () {
        var lang = null;
        var path = base && location.pathname.indexOf(base) === 0 ? location.pathname.slice(base.length) : location.pathname;
        var m = path.match(/^\/(en|ru)(\/|$)/);
        if (m) lang = m[1];
        if (!lang) {
          try {
            var saved = localStorage.getItem('aiquest:lang');
            if (saved === 'en' || saved === 'ru') lang = saved;
          } catch (e) {}
        }
        if (!lang) return; // unknown: show both
        document.documentElement.lang = lang;
        var blocks = document.querySelectorAll('[data-lang-block]');
        for (var i = 0; i < blocks.length; i++) {
          if (blocks[i].getAttribute('data-lang-block') !== lang) blocks[i].hidden = true;
        }
        var title = document.querySelector('[data-lang-block="' + lang + '"] h1');
        if (title) document.title = title.textContent + ' · AI Engineer Quest';
      })();
    </script>
  </body>
</html>
